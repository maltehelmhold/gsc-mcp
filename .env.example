# gsc-mcp: Google Search Console MCP-Server
# Wird automatisch gefunden, im MCP-Eintrag der Claude-App braucht
# nichts davon zu stehen.

# Pfad zum Service-Account-Key (JSON). Pflicht.
GSC_KEY_FILE=~/.gsc-mcp/service-account.json

# Property, die ohne site_url benutzt wird.
# Domain-Property:  sc-domain:example.com
# URL-Praefix:      https://example.com/
GSC_DEFAULT_SITE=sc-domain:example.com

# Auf 1 setzen, dann fehlen die schreibenden Tools und der Server
# fordert nur den readonly-Scope an.
GSC_READONLY=
